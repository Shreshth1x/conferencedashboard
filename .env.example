PORT=4173
# Optional hosted storage. Apply the migration in supabase/migrations first.
# Use a direct PostgreSQL or session-pooler URI and a persistent 32-byte base64 key.
CONFERENCE_DATABASE_URL=
CONFERENCE_SECRETS_KEY=
# Optional PEM certificate for a database with a private root CA.
CONFERENCE_DATABASE_CA=

# Put the Google OAuth credentials for a Web application here.
# Register the exact redirect URI in the Google Cloud Console and enable Gmail API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:4173/api/gmail/callback

# These keys can also be saved from Connections. Paid providers run only when selected.
EXA_API_KEY=
APOLLO_API_KEY=
AUTUMN_API_KEY=
# Optional path to the local Codex executable. ChatGPT authentication stays in Codex.
CODEX_BIN=
